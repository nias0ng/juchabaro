pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Backend Test') {
            steps {
                dir('backend') {
                    sh 'chmod +x gradlew'
                    sh './gradlew clean test'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                    testResults: 'backend/build/test-results/test/*.xml'
        }
    }
}