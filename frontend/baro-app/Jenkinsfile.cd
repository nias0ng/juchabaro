pipeline {
    agent any

    tools {
        nodejs 'node20'
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        EXPO_PUBLIC_API_BASE_URL = 'https://i15e202.p.ssafy.io'
        DEPLOY_DIR = '/var/www/baro-app'
    }

    stages {
        stage('Install') {
            steps {
                dir('frontend/baro-app') {
                    sh 'npm ci'
                }
            }
        }

        stage('Typecheck') {
            steps {
                dir('frontend/baro-app') {
                    sh 'npm run typecheck'
                }
            }
        }

        stage('Build Web') {
            steps {
                dir('frontend/baro-app') {
                    sh 'npx expo export --platform web'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('frontend/baro-app') {
                    sh '''
                        tar -C dist -cf - . | \
                        docker run --rm -i \
                          -v ${DEPLOY_DIR}:/dest \
                          alpine sh -c "rm -rf /dest/* && mkdir -p /dest && tar -C /dest -xf -"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Web deploy 완료: https://i15e202.p.ssafy.io'
        }
        failure {
            echo 'Web deploy 실패 - 로그 확인 필요'
        }
    }
}