{
  "expo": {
    "name": "baro-app",
    "slug": "baro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/baro-icon.png",
    "scheme": "baroapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/baro-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chaewon105steam.baroapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89b7d75b-0f82-4629-aaf7-523c122d94fc"
      }
    }
  }
}
