pipeline {
    agent any

    tools {
        nodejs 'node20'
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Install') {
            steps {
                dir('frontend/baro-app') {
                    sh 'npm ci'
                }
            }
        }
        stage('Typecheck') {
            steps {
                dir('frontend/baro-app') {
                    sh 'npm run typecheck'
                }
            }
        }
    }
}