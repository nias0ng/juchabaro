APP_NAME=Smart Parking Jetson API
LOG_LEVEL=INFO

BACKEND_BASE_URL=http://localhost:8080

HW_API_KEY=
INTERNAL_API_KEY=

# Jetson 배포용 versioned 구역 정의. 실제 카메라 좌표계에 맞는 파일로 교체한다.
ZONE_DEFINITION_PATH=config/zone_definition.pilot.json

# 구역 방문 확인시간(초) — T-18에서 파일럿 영상으로 산출할 값이다.
# 아래는 개발 편의용 임시값이며 운영 기본값이 아니다.
ZONE_ENTRY_CONFIRM_SECONDS=3.0
ZONE_EXIT_CONFIRM_SECONDS=3.0

# 입차 이벤트 매칭 대기 시간(초) — 기본값 10.0을 그대로 씀. 생략 가능.
ENTRY_MATCH_WINDOW_SECONDS=10.0

# 주차 확정 임계값(초). PARKING_CONFIRM_SECONDS=600은 요구사항 값이다.
# PARKING_MOVE_CONFIRM_SECONDS는 T-18에서 파일럿 영상으로 산출할 값이며
# 아래는 개발 편의용 임시값이다.
PARKING_CONFIRM_SECONDS=600.0
PARKING_MOVE_CONFIRM_SECONDS=3.0
