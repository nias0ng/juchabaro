APP_NAME=Smart Parking Jetson API
LOG_LEVEL=INFO

BACKEND_BASE_URL=https://i15e202.p.ssafy.io/
BACKEND_HW_API_KEY=

INTERNAL_API_KEY=

# 듀얼 VL53L0X ToF 센서 설정.
# TOF_I2C_BUS=7은 배선 계약의 확정값이 아니라 초기 예시다.
# 실제 Jetson에서 /dev/i2c-*와 i2cdetect -l로 확인한 번호로 교체한다.
# 시간값도 초기 bring-up용 예시이며 실제 하드웨어 확인 후 조정한다.
TOF_I2C_BUS=7
TOF_SHUTDOWN_SETTLE_SECONDS=0.01
TOF_BOOT_SETTLE_SECONDS=0.01
TOF_IO_TIMEOUT_SECONDS=1.0

# ToF 센서와 실제 zone definition의 결속.
TOF_DISABLED_ZONE_ID=4
TOF_EV_CHARGING_ZONE_ID=5

# 설치 높이와 차량 반사 조건 검증 전 provisional 값.
TOF_ENTER_DISTANCE_MM=150
TOF_EXIT_DISTANCE_MM=220

# 아직 메인 runtime에 연결되지 않은 provisional 값이다.
# ToF 연결 시 실제 설치 환경에서 다시 측정한다.
TOF_POLL_INTERVAL_SECONDS=0.05
TOF_ENTER_CONFIRM_SECONDS=0.0
TOF_EXIT_CONFIRM_SECONDS=0.0
TOF_TRUSTED_SAMPLE_MAX_GAP_SECONDS=1.0
TOF_STALE_AFTER_SECONDS=2.0

# Jetson local durable state. 실행 중 생성되는 DB는 Git에 포함하지 않는다.
DATABASE_PATH=data/jetson.db

# Evidence still-image spool. 8GiB는 충분한 여유공간이 있을 때의 상한이며,
# 35%에서 새 capture를 중지하고 30% filesystem 보호 floor를 유지한다.
EVIDENCE_SPOOL_PATH=data/evidence
EVIDENCE_SPOOL_CAP_BYTES=8589934592
EVIDENCE_FILESYSTEM_FLOOR_RATIO=0.30
EVIDENCE_CAPTURE_STOP_FREE_RATIO=0.35
EVIDENCE_ACK_RETENTION_SECONDS=86400
EVIDENCE_UNACKED_RETENTION_SECONDS=604800

# Jetson 메인 배포용 full-frame 구역 정의 정본(version 1).
ZONE_DEFINITION_PATH=config/zone_definition.json

# Zone의 관측·표시 상태와 분리된 이중주차 출차 방해 영역.
EGRESS_AISLE_PATH=config/egress_aisle.json

# 운영 USB camera. 단일 카메라의 초기 장치 index는 0으로 사용한다.
CAMERA_ID=PARKING-CAMERA-01
CAMERA_INDEX=0

# 0이면 카메라 장치 기본 해상도를 요청한다.
CAMERA_WIDTH=0
CAMERA_HEIGHT=0

# `/home/e202`에 배치하는 운영 calibration과 차량 모델 경로.
# 파일 존재·형식 및 calibration 파일 SHA fingerprint 일치는 기동
# preflight에서 검증한다.
CALIBRATION_PATH=/home/e202/config/camera_calibration.json

# REMAP_BALANCE를 변경하면 보정 결과 좌표계가 달라질 수 있다.
# 현재 zone calibrationReference에는 balance가 포함되지 않으므로 zone을
# 생성할 때 사용한 값과 동일하게 유지해야 한다. 0.5가 운영 zone 생성에
# 사용된 값인지는 배포 전에 별도로 확인해야 한다.
REMAP_BALANCE=0.5

VEHICLE_MODEL_PATH=/home/e202/model/yolov8s.pt
VEHICLE_TRACKER_CONFIG=bytetrack.yaml

# 0.25는 시연 영상에서 저신뢰 차량 검출 단절을 줄이기 위한 provisional confidence다.
# 운영 모델의 precision/recall 측정 결과에 따라 재조정해야 한다.
VEHICLE_TRACKING_CONFIDENCE=0.25

# SideMaskingDetector 마스크 경계가 실제 zone polygon x-범위에 더하는 여백
# 비율(537 코드리뷰 반영). 최종 경계는 항상 ZONE_DEFINITION_PATH에서 자동
# 계산하고, 이 값만 조정한다.
MASK_MARGIN_RATIO=0.04

# 구역 방문 확인시간(초) — T-18(466)이 파일럿 영상(video1/2/3) 리플레이로 산출했다.
# 상태·timer 계약: docs/architecture/jetson/02-scope-lifecycle-contract.md
#
# ZONE_ENTRY_CONFIRM_SECONDS=1.0: 문턱값 그리드([0.5, 1.0, 2.0, ...]) 중 오탐 0건을
# 만드는 가장 작은 값이다. 오탐 없이 확정 가능한 실제 경계는 0.5초(오탐 1건 발생)와
# 0.733초(가장 짧은 실제 정차) 사이 어딘가이지만, 그리드가 그 구간을 더 잘게 재지
# 않아 다음 그리드 값인 1.0을 안전 마진으로 채택했다 — "정밀한 경계값"이 아니라
# "그리드상 안전한 값"이다.
ZONE_ENTRY_CONFIRM_SECONDS=1.0
#
# ZONE_EXIT_CONFIRM_SECONDS=5.0: 같은 물리 차량이 방문을 닫자마자 같은 구역에
# 재진입하는 "탐지 순간 끊김" 간격 40건(파일럿 영상 3개, 구역 전체)을 측정해
# 최댓값(4.067초)보다 큰 가장 작은 반올림 값을 채택했다. 이 방법은 ByteTrack의
# track_buffer(추적 유지 한도)보다 긴 끊김은 원천적으로 못 본다 — 그보다 길게
# 끊기면 같은 차량이 재식별 없이(T-13 이전) 새 physical_vehicle_id를 받아 이
# 측정에 아예 잡히지 않기 때문이다. 그래서 4.067초는 "관측된 최댓값"이지 "가능한
# 최댓값"이 아니며, 실제 재식별(T-13)이 배선된 뒤 다시 측정해 재검증해야 한다.
ZONE_EXIT_CONFIRM_SECONDS=5.0

# 새 규칙만을 위한 compatibility fallback. 알려진 규칙은 아래 값을 반드시 사용한다.
ENTRY_ZONE_MIN_OVERLAP_RATIO=0.40
INCIDENT_CONFIRM_SECONDS=0.0
INCIDENT_CLEAR_SECONDS=0.0

# 규칙별 Incident confirm/clear 정책(초).
# 권한·세션 기반 규칙은 즉시 전이하고, 영상 기하 규칙은 0.5초 debounce를 적용한다.
INCIDENT_DISABLED_ZONE_UNAUTHORIZED_CONFIRM_SECONDS=0.0
INCIDENT_DISABLED_ZONE_UNAUTHORIZED_CLEAR_SECONDS=0.0
INCIDENT_EV_ZONE_UNAUTHORIZED_CONFIRM_SECONDS=0.0
INCIDENT_EV_ZONE_UNAUTHORIZED_CLEAR_SECONDS=0.0
INCIDENT_EV_OVERSTAY_CONFIRM_SECONDS=0.0
INCIDENT_EV_OVERSTAY_CLEAR_SECONDS=0.0
INCIDENT_BAD_PARKING_CONFIRM_SECONDS=0.5
INCIDENT_BAD_PARKING_CLEAR_SECONDS=0.5
INCIDENT_OUT_OF_ZONE_CONFIRM_SECONDS=0.5
INCIDENT_OUT_OF_ZONE_CLEAR_SECONDS=0.5
INCIDENT_AISLE_BLOCK_CONFIRM_SECONDS=0.5
INCIDENT_AISLE_BLOCK_CLEAR_SECONDS=0.5
INCIDENT_DOUBLE_PARKING_CONFIRM_SECONDS=0.0
INCIDENT_DOUBLE_PARKING_CLEAR_SECONDS=0.0

# 아래 값은 운영 확정값이 아니다.
# 재식별 값은 live viewer와 README replay 예시에서 공통으로 사용한 값이다.
REIDENTIFICATION_MAX_GAP_SECONDS=4.0
REIDENTIFICATION_MIN_SCORE=0.42
REIDENTIFICATION_AMBIGUITY_MARGIN=0.08

# zone presence와 assignment 값은 viewer/replay에서 사용한 provisional 값이다.
ZONE_PRESENCE_MIN_OVERLAP_RATIO=0.40
ASSIGNMENT_MIN_OVERLAP_RATIO=0.50
ASSIGNMENT_AMBIGUOUS_MARGIN=0.05
BAD_PARKING_MIN_PRIMARY_OVERLAP_RATIO=0.75
BAD_PARKING_MIN_SECONDARY_OVERLAP_RATIO=0.25
OUT_OF_ZONE_MIN_SPOT_OVERLAP_RATIO=0.50

# 운영 확정값이 없어 현재 replay 예시의 provisional 값을 사용한다.
BLOCKING_RELATION_CONFIRM_SECONDS=1.0
BLOCKING_RELATION_CLEAR_SECONDS=1.0

# 이중주차 geometry의 provisional 기준. subject 차량에서 egress와 겹치는
# 비율 또는 egress 전체에서 차량이 덮는 비율 중 하나가 기준 이상이면 후보가 된다.
BLOCKING_MIN_SUBJECT_OVERLAP_RATIO=0.40
BLOCKING_MIN_EGRESS_COVERAGE_RATIO=0.40

# 입차 이벤트 매칭 대기 시간(초) — 기본값 10.0을 그대로 씀. 생략 가능.
ENTRY_MATCH_WINDOW_SECONDS=10.0

# 정상 전체 구역 관측에서 미관측이 지속될 때만 부재로 확정한다.
# 5초는 개발·시연용 임시값이며 파일럿 리플레이로 재조정한다.
ABSENCE_CONFIRMATION_SECONDS=5.0

# 연속 관측으로 인정할 최대 frame 간격(초).
# 1초는 5fps 파일럿의 임시값이며 replay·soak test로 조정한다.
TRUSTED_SAMPLE_MAX_GAP_SECONDS=1.0

# MotionEstimator의 bbox evidence 정책. 아래 값은 현재 파일럿 replay용 provisional
# 값이며 운영 배포 전에 영상별 UNKNOWN/MOVING/STATIONARY 분포로 재조정한다.
# 거리 임계값은 화면 픽셀이 아니라 현재 창의 median bbox diagonal 대비 비율이다.
MOTION_WINDOW_SECONDS=0.75
MOTION_MIN_OBSERVATION_SPAN_SECONDS=0.20
MOTION_MAX_SAMPLE_GAP_SECONDS=0.50
MOTION_STATIONARY_THRESHOLD=0.03
MOTION_MOVING_THRESHOLD=0.10
MOTION_MIN_SAMPLES=3
MOTION_MIN_TREND_CONSISTENCY=0.60

# 시연용 주차 확정 임계값(초). 운영 요구값 600.0은 실영상 검증 후 별도 적용한다.
PARKING_CONFIRM_SECONDS=5.0

# 이동 확정값은 T-18 측정 범위에서 제외되었고 아직 재측정하지 않았다.
# 아래 0.5초는 개발·시연용 provisional 값이며 운영 전에 재측정한다.
PARKING_MOVE_CONFIRM_SECONDS=0.5
